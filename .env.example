# ================= IKYYBOT - Environment Variables =================
# Salin file ini menjadi .env, lalu isi nilainya:
#     cp .env.example .env
#
# WAJIB: token bot Discord.
# Ambil / reset di: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=isi_token_bot_discord_kamu_di_sini

# ------------------------- OPSIONAL (ada default) ------------------
# Prefix perintah chat (default: !)
PREFIX=!

# Paksa path ffmpeg manual. Kosongkan untuk memakai ffmpeg-static bawaan npm.
# Di VPS Linux yang sudah punya ffmpeg sistem, isi: /usr/bin/ffmpeg
#FFMPEG_PATH=/usr/bin/ffmpeg

# ------------------------- PENCARIAN LAGU (opsional) ----------------
# Awalan pencarian yt-dlp untuk `!play <judul>`. Default: ytsearch1: (hasil teratas).
# Contoh lain: ytsearch5: (tetap dipakai hasil pertama, tapi daftarnya 5).
#YTDLP_SEARCH_PREFIX=ytsearch1:

# ------------------------- YT-DLP / YOUTUBE (opsional) --------------
# Sejak yt-dlp 2025.11.12, YouTube butuh JavaScript runtime eksternal.
# Default otomatis: `node` (bot juga jalan di Node.js). Isi manual bila perlu.
#YTDLP_JS_RUNTIME=node

# File cookies.txt dari browser yang sudah login YouTube.
# Dipakai bila muncul "Sign in to confirm you're not a bot" (umum di IP VPS).
#YTDLP_COOKIES=/home/ikyy/Bot-discord/cookies.txt

# Argumen ekstraktor YouTube (contoh): youtube:player_client=web_safari
#YTDLP_EXTRACTOR_ARGS=

# Format audio untuk streaming. Default: ba/ba* (best audio).
#YTDLP_FORMAT=ba/ba*

# Set 1 bila TIDAK ingin bot menulis ~/.config/yt-dlp/config otomatis.
#YTDLP_SKIP_USER_CONFIG=1

# Mode runtime
NODE_ENV=production
